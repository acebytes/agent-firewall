# Copy to .env and fill in.
# The harness loads this via `./run.sh rebuild` → `docker run --env-file .env`.

# Required: Claude Code needs an Anthropic API key to run.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude Code version pinned into the image.
# Accepts a specific version ("2.1.0"), a dist-tag ("latest", "2", "1"), or
# omit for the Dockerfile default ("latest").
# CLAUDE_CODE_VERSION=latest

# Optional: number of fuzzer trials for experiment 16 (default 500).
# EXP16_TRIALS=500
